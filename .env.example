# Nearby — build/runtime environment variables (T-140).
#
# Copy to `.env.local` for local dev (git-ignored). For EAS cloud builds these must be provided
# as EAS environment variables (per profile), NOT committed here:
#   eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "<url>" --environment preview --environment production
#   ...repeat for each var below.
#
# All are EXPO_PUBLIC_* — they are embedded in the client bundle by design. The Supabase
# publishable/anon key and PostHog project key are client-side keys (RLS- and ingest-scoped),
# safe to ship in the app. Do NOT put the Supabase *service* key here or in any client env.

# Supabase (T-129) — project URL + publishable/anon key
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostHog EU Cloud (T-005/T-035) — project API key + host
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# RevenueCat (T-083/T-084): the PUBLIC app-specific SDK key for the Play Store app (`goog_…`).
# Safe to ship in the app. Never put a RevenueCat secret key (`sk_…`) in any client env.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
