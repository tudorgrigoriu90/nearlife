{
  "expo": {
    "name": "Nearby",
    "slug": "nearby",
    "version": "0.1.0",
    "scheme": "nearby",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nearlife.nearby"
    },
    "android": {
      "package": "com.nearlife.nearby",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nearby uses your location once to set your home region, then discards the coordinates."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27adb571-a470-4052-bb0f-c2a35fbedb39"
      }
    }
  }
}
